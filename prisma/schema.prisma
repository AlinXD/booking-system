generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// name, email, phone, date, kids, age, pack, notes
model Appointment {
  id     Int             @id @default(autoincrement())
  date   DateTime        @unique
  sent   DateTime        @default(now())
  name   String
  email  String
  phone  String
  kids   Int
  age    AgeGroup
  type   AppointmentType @default(Small)
  notes  String?
  status Status          @default(Pending)
}

model Review {
  id      Int      @id @default(autoincrement())
  created DateTime @default(now())
  name    String   @default("Ion Pop")
  rating  Int      @default(5)
  text    String?
}

model AdminAccount {
  id       Int      @id @default(autoincrement())
  created  DateTime @default(now())
  name     String   @unique
  password String
}

enum AppointmentType {
  Small
  Medium
  Large
}

enum AgeGroup {
  OneToThree
  ThreeToSix
  SixToTwelve
  Mixed
}

enum Status {
  Pending
  Accepted
  Rejected
}
